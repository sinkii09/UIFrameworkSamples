    "m_SourceType": 1,
    "m_FunctionName": "HoloTri",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "HoloColor = float3(0.0, 0.0, 0.0);\r\nfloat2 scaled = UV * Frequency;\r\nfloat2 cell = floor(scaled);\r\nfloat2 localUV = frac(scaled);\r\nfloat isUpper = step(1.0, localUV.x + localUV.y);\r\nfloat hash = frac(sin(cell.x * 127.1 + cell.y * 311.7 + isUpper * 74.3) * 43758.5453);\r\nfloat dist = abs(frac(hash - Rotation + 0.5) - 0.5) * 2.0;\r\nfloat visibility = 1.0 - smoothstep(0.0, Spread, dist);\r\nfloat hue = frac(hash + Rotation);\r\nfloat cr = saturate(abs(frac(hue) * 6.0 - 3.0) - 1.0);\r\nfloat cg = saturate(abs(frac(hue + 0.6667) * 6.0 - 3.0) - 1.0);\r\nfloat cb = saturate(abs(frac(hue + 0.3333) * 6.0 - 3.0) - 1.0);\r\nHoloColor = float3(cr, cg, cb) * visibility;\r\n"
}

